# Agri Expert Backend Environment Variables
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to version control!

# OpenWeatherMap API Key (optional - for weather endpoint)
# Get yours free at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# App settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Google Gemini API key (required for agricultural chat)
# Keep this only on the backend/Render environment.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Official market-price adapter (optional until an Agmarknet adapter is configured)
MARKET_PRICE_API_URL=
MARKET_PRICE_API_KEY=
